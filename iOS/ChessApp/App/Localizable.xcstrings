    "Changing to %@ requires resetting the game because a new coaching session will be created. This will start a fresh game at the new difficulty level." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wechsel zu %@ erfordert ein Zurücksetzen des Spiels, da eine neue Coaching-Sitzung erstellt wird. Dies startet ein neues Spiel auf dem neuen Schwierigkeitsgrad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换到%@需要重置游戏，因为将创建新的指导会话。这将以新的难度等级开始新游戏。"
          }
        }
      }
    },
